<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <system.webServer>
        <rewrite>
            <rules>

                <!-- 1. Redirect physical /wiser_py/login folder to /wiser_py/ -->
                <rule name="Redirect login folder" stopProcessing="true">
                    <match url="^wiser_py/login/?$" ignoreCase="true" />
                    <conditions>
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" />
                    </conditions>
                    <action type="Redirect" url="/wiser_py/" redirectType="Permanent" />
                </rule>

                <!-- 2. Redirect /wiser_py (no slash) to /wiser_py/ -->
                <rule name="Add trailing slash" stopProcessing="true">
                    <match url="^wiser_py$" ignoreCase="true" />
                    <action type="Redirect" url="/wiser_py/" redirectType="Permanent" />
                </rule>

                <!-- 3. Internally rewrite /wiser_py/ to Flask /login -->
                <rule name="Rewrite wiser_py root to Flask login" stopProcessing="true">
                    <match url="^wiser_py/$" ignoreCase="true" />
                    <conditions>
                        <!-- Only rewrite if not an existing file/folder -->
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="http://127.0.0.1:5000/login" />
                    <serverVariables>
                        <set name="HTTP_X_FORWARDED_PROTO" value="https" />
                        <set name="HTTP_X_FORWARDED_PREFIX" value="/wiser_py" />
                    </serverVariables>
                </rule>

                <!-- 4. Proxy all other /wiser_py/* requests to Flask backend -->
                <rule name="Proxy wiser_py paths" stopProcessing="true">
                    <match url="^wiser_py/(.*)" ignoreCase="true" />
                    <conditions>
                        <!-- Only proxy if not an existing file/folder -->
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="http://127.0.0.1:5000/{R:1}" appendQueryString="true" />
                    <serverVariables>
                        <set name="HTTP_X_FORWARDED_PROTO" value="https" />
                        <set name="HTTP_X_FORWARDED_PREFIX" value="/wiser_py" />
                    </serverVariables>
                </rule>

            </rules>

            <!-- Allow forwarding of custom headers to backend -->
            <!-- <allowedServerVariables>
                <add name="HTTP_X_FORWARDED_PROTO" />
                <add name="HTTP_X_FORWARDED_PREFIX" />
            </allowedServerVariables> -->
        </rewrite>

        <!-- Enable IIS reverse proxy module -->
        <proxy>
            <reverseProxy enabled="true" />
        </proxy>
    </system.webServer>
</configuration>
